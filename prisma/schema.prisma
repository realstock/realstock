generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model InstagramPreviewSession {
  id               String   @id @default(cuid())
  listingId        Int
  postType         String   @default("carousel")
  caption          String?
  status           String   @default("DRAFT")
  allImageUrls     Json
  selectedImages   Json
  validationReport Json?
  publishErrors    Json?
  containerIds     Json?
  publishedMediaId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FacebookFeedSession {
  id               String   @id @default(cuid())
  listingId        Int
  postType         String   @default("carousel")
  caption          String?
  status           String   @default("DRAFT")
  allImageUrls     Json
  selectedImages   Json
  validationReport Json?
  publishErrors    Json?
  publishedPostId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model YoutubeShortsSession {
  id            String   @id @default(cuid())
  listingId     Int
  status        String   @default("DRAFT")
  caption       String?
  videoId       String?  @map("video_id")
  permalink     String?
  publishErrors Json?    @map("publish_errors")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("youtube_shorts_sessions")
}

model User {
  id                          Int        @id @default(autoincrement())
  email                       String     @unique
  instagram                   String?
  password                    String
  avatar                      String?
  bio                         String?
  city                        String?
  country                     String?
  cpfCnpj                     String?
  createdAt                   DateTime   @default(now())
  name                        String
  paypalEmail                 String?
  phone                       String?
  role                        String     @default("USER")
  state                       String?
  updatedAt                   DateTime   @updatedAt
  verified                    Boolean    @default(false)
  companyLogo                 String?    @map("company_logo")
  identityDocumentUrl         String?    @map("identity_document_url")
  identityDocumentVerified    Boolean    @default(false) @map("identity_document_verified")
  logoBoostedUntil            DateTime?  @map("logo_boosted_until")
  portfolioBoostedUntil       DateTime?  @map("portfolio_boosted_until")
  googlePortfolioBoostedUntil DateTime?  @map("google_portfolio_boosted_until")
  metaPortfolioBoostedUntil   DateTime?  @map("meta_portfolio_boosted_until")
  metaPortfolioAdId           String?    @map("meta_portfolio_ad_id")
  metaPortfolioCampaignId     String?    @map("meta_portfolio_campaign_id")
  portfolioVideoUrl           String?    @map("portfolio_video_url")
  portfolioVideoPaidAt        DateTime?  @map("portfolio_video_paid_at")
  
  // TikTok Integration
  tiktok                      String?
  tiktokId                    String?    @map("tiktok_id")
  tiktokAccessToken           String?    @map("tiktok_access_token")
  tiktokRefreshToken          String?    @map("tiktok_refresh_token")
  tiktokTokenExpiresAt        DateTime?  @map("tiktok_token_expires_at")

  // YouTube Integration
  youtubeAccessToken          String?    @map("youtube_access_token")
  youtubeRefreshToken         String?    @map("youtube_refresh_token")
  youtubeTokenExpiresAt       DateTime?  @map("youtube_token_expires_at")
  
  // Sistema de Indicação e Créditos
  referrerId                  Int?       @map("referrer_id")
  referrer                    User?      @relation("UserReferrals", fields: [referrerId], references: [id])
  referrals                   User[]     @relation("UserReferrals")
  viralizarCredits            Int        @default(1) @map("viralizar_credits")
  turbinarCredits             Decimal    @default(0) @map("turbinar_credits") @db.Decimal(10, 2)
  referralCode                String?    @unique @map("referral_code")

  offers                      Offer[]                @relation("BuyerOffers")
  properties                  Property[]
  financialTransactions       FinancialTransaction[]
  buyerConversations          Conversation[]         @relation("BuyerConversations")
  sellerConversations         Conversation[]         @relation("SellerConversations")
  sentMessages                ChatMessage[]          @relation("SentMessages")
  autoMessageSettings         AutoMessageSetting[]

  @@map("users")
}

model Property {
  id                  Int             @id @default(autoincrement())
  title               String
  description         String?
  price               Decimal
  legalStatus         String          @map("legal_status")
  area                String
  city                String
  neighborhood        String?
  category            String?
  propertyType        String?         @map("property_type")
  areaBuilt           String?         @map("area_built")
  bedrooms            Int?
  bathrooms           Int?
  parkingSpaces       Int?            @map("parking_spaces")
  suites              Int?
  furnished           Boolean         @default(false)
  condominium         Boolean         @default(false)
  condominiumFee      Decimal?        @map("condominium_fee")
  acceptsFinancing    Boolean         @default(false) @map("accepts_financing")
  frontSea            Boolean         @default(false) @map("front_sea")
  pool                Boolean         @default(false)
  latitude            Decimal
  longitude           Decimal
  ownerId             Int             @map("owner_id")
  createdAt           DateTime        @default(now()) @map("created_at")
  country             String?         @default("Brasil")
  googleMapsLink      String?         @map("google_maps_link")
  state               String?
  street              String?
  zipCode             String?         @map("zip_code")
  addressNumber       String?         @map("address_number")
  googleMapsThumbnail String?         @map("google_maps_thumbnail")
  topographyPoints    String?         @map("topography_points")
  youtubeLink         String?         @map("youtube_link")
  youtubeThumbnail    String?         @map("youtube_thumbnail")
  boostedUntil        DateTime?       @map("boosted_until")
  googleBoostedUntil  DateTime?       @map("google_boosted_until")
  metaBoostedUntil    DateTime?       @map("meta_boosted_until")
  metaAdId            String?         @map("meta_ad_id")
  metaCampaignId      String?         @map("meta_campaign_id")
  sponsoredUntil      DateTime?       @map("sponsored_until")
  instagramMediaId    String?         @map("instagram_media_id")
  instagramPermalink  String?         @map("instagram_permalink")
  reelsVideoUrl       String?         @map("reels_video_url")
  reelsVideoPaidAt    DateTime?       @map("reels_video_paid_at")
  reelsMusicUrl       String?         @map("reels_music_url")
  customVideoUrl      String?         @map("custom_video_url")
  listingType         String          @default("COMPRA_VENDA") @map("listing_type")
  minNights           Int?            @map("min_nights")
  maxGuests           Int?            @map("max_guests")
  depositPercentage   Decimal?        @default(20) @map("deposit_percentage") @db.Decimal(5, 2)
  pixKey              String?         @map("pix_key")
  pixQrCodeUrl        String?         @map("pix_qrcode_url")
  icalFeeds           Json?           @default("[]") @map("ical_feeds")
  customRates         Json?           @default("{}") @map("custom_pricing")
  contactFeePaidAt    DateTime?       @map("contact_fee_paid_at")
  sold                Boolean         @default(false)
  checkInInstructions String?         @map("check_in_instructions")
  checkInTime         String?         @default("14:00") @map("check_in_time")
  checkOutTime        String?         @default("12:00") @map("check_out_time")
  offers              Offer[]
  owner               User            @relation(fields: [ownerId], references: [id])
  images              PropertyImage[]
  videos              PropertyVideo[]
  conversations       Conversation[]

  @@map("properties")
}

model PropertyImage {
  id         Int      @id @default(autoincrement())
  propertyId Int      @map("property_id")
  imageUrl   String   @map("image_url")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  property   Property @relation(fields: [propertyId], references: [id])

  @@map("property_images")
}

model PropertyVideo {
  id         Int      @id @default(autoincrement())
  propertyId Int      @map("property_id")
  videoUrl   String   @map("video_url")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  property   Property @relation(fields: [propertyId], references: [id])

  @@map("property_videos")
}

model Offer {
  id                         Int       @id @default(autoincrement())
  propertyId                 Int       @map("property_id")
  buyerId                    Int       @map("buyer_id")
  offerPrice                 Decimal   @map("offer_price")
  status                     String    @default("open")
  startDate                  DateTime? @map("start_date")
  endDate                    DateTime? @map("end_date")
  guests                     Int?      @default(1)
  depositAmount              Decimal?  @map("deposit_amount") @db.Decimal(10, 2)
  totalStayPrice             Decimal?  @map("total_stay_price") @db.Decimal(10, 2)
  hostFeePaidAt              DateTime? @map("host_fee_paid_at")
  pixReceiptUrl              String?   @map("pix_receipt_url")
  pixValidation              Json?     @map("pix_validation")
  checkInReleasedAt          DateTime? @map("check_in_released_at")
  remainingBalanceReceiptUrl String?   @map("remaining_balance_receipt_url")
  remainingBalanceValidation Json?     @map("remaining_balance_validation")
  guestRating                Int?      @map("guest_rating")
  hostRating                 Int?      @map("host_rating")
  expiresAt                  DateTime? @map("expires_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  buyer            User      @relation("BuyerOffers", fields: [buyerId], references: [id])
  property         Property  @relation(fields: [propertyId], references: [id])

  @@map("offers")
}

model OfferPayment {
  id                 Int       @id @default(autoincrement())
  offerId            Int       @map("offer_id")
  propertyId         Int       @map("property_id")
  buyerId            Int       @map("buyer_id")
  sellerId           Int       @map("seller_id")
  acceptedOfferValue Decimal   @map("accepted_offer_value")
  paymentAmount      Decimal   @map("payment_amount")
  paypalOrderId      String?   @map("paypal_order_id")
  paypalCaptureId    String?   @map("paypal_capture_id")
  paymentStatus      String    @default("pending") @map("payment_status")
  contactReleased    Boolean   @default(false) @map("contact_released")
  createdAt          DateTime  @default(now()) @map("created_at")
  paidAt             DateTime? @map("paid_at")

  @@map("offer_payments")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model SiteFee {
  id          Int           @id @default(autoincrement())
  name        String
  type        FeeType
  value       Decimal       @db.Decimal(10, 2)
  description String?
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  services    SiteService[]

  @@map("site_fees")
}

model SiteService {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  feeId       Int?     @map("fee_id")
  fee         SiteFee? @relation(fields: [feeId], references: [id])

  @@index([feeId])
  @@map("site_services")
}

model GoogleAdsSession {
  id         String   @id @default(cuid())
  listingId  Int
  campaignId String?
  adGroupId  String?
  status     String   @default("ACTIVE")
  budget     Decimal
  targetUrl  String
  budgetDays Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("google_ads_sessions")
}

model EmailMessage {
  id          String         @id @default(cuid())
  threadId    String?
  sender      String
  recipient   String
  subject     String?
  htmlBody    String?
  textBody    String?
  status      EmailStatus    @default(UNREAD)
  direction   EmailDirection @default(INBOUND)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  inReplyToId String?
  inReplyTo   EmailMessage?  @relation("EmailReplies", fields: [inReplyToId], references: [id])
  replies     EmailMessage[] @relation("EmailReplies")
}

model AdminSponsoredPublication {
  id                 String    @id @default(cuid())
  name               String?
  propertyIds        Json
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  googleBoostedUntil DateTime?
  metaBoostedUntil   DateTime?
  metaAdId           String?
  metaCampaignId     String?
  instagramMediaId   String?
  instagramPermalink String?
  customLogoUrl      String?   @map("custom_logo_url")

  @@map("admin_sponsored_publications")
}

model FinancialTransaction {
  id          String              @id @default(cuid())
  type        TransactionType
  category    TransactionCategory
  amount      Decimal             @db.Decimal(10, 2)
  currency    String              @default("BRL")
  description String?
  referenceId String?
  userId      Int?                @map("user_id")
  user        User?               @relation(fields: [userId], references: [id])
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@map("financial_transactions")
}

enum UserRole {
  USER
  ADMIN
}

enum TransactionType {
  REVENUE
  EXPENSE
}

enum TransactionCategory {
  SPONSOR
  OFFER
  POSTS
  ADS_BOOST
  PAYPAL_FEE
  META_ADS
  GOOGLE_ADS
  VERCEL
  SUPABASE
  REELS_VIDEO
  OTHER
}

enum FeeType {
  FIXED
  PERCENTAGE
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailStatus {
  UNREAD
  READ
  SPAM
}

model MetaAdsSession {
  id         String   @id @default(cuid())
  listingId  Int
  campaignId String?
  status     String   @default("IN_PROCESS")
  budget     Decimal
  budgetDays Int
  platform   String   @default("meta")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("meta_ads_sessions")
}

model Coupon {
  id           String   @id @default(cuid())
  code         String   @unique
  serviceType  String   @map("service_type") // "VIRALIZAR" ou "TURBINAR"
  value        Decimal  @default(0) @db.Decimal(10, 2)
  maxUses      Int      @default(1) @map("max_uses")
  currentUses  Int      @default(0) @map("current_uses")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("coupons")
}

model Conversation {
  id           Int           @id @default(autoincrement())
  propertyId   Int?          @map("property_id")
  property     Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  buyerId      Int           @map("buyer_id")
  buyer        User          @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId     Int           @map("seller_id")
  seller       User          @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  lastMessage  String?       @map("last_message")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  messages     ChatMessage[]

  @@unique([propertyId, buyerId, sellerId])
  @@map("conversations")
}

model ChatMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int          @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int          @map("sender_id")
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  text           String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("chat_messages")
}

model AutoMessageSetting {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       String   @map("event") // "ON_RESERVATION_REQUEST", "ON_HOST_ACCEPT", etc. or "CUSTOM_1", "CUSTOM_2", "CUSTOM_3", "CUSTOM_4"
  customTitle String?  @map("custom_title")
  targetEvent String?  @map("target_event")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  messageText String   @map("message_text") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, event])
  @@map("auto_message_settings")
}

